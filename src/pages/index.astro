---
import Layout from '../layouts/Layout.astro';
import { site, services } from '../data/site';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: site.name,
  url: site.url,
  telephone: '+17606834546',
  email: site.email,
  areaServed: site.cities.map((c) => ({ '@type': 'City', name: c })),
};
---

<Layout
  title="Custom Outdoor Living Spaces in San Diego | Outdoor Living Landscape"
  description="Custom pools, outdoor kitchens, pergolas and hardscape in San Diego County, including Carlsbad, Encinitas, Solana Beach, Del Mar and Rancho Santa Fe."
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <section class="hero has-photo">
    <div class="wrap">
      <h1>Custom Outdoor Living Spaces in San Diego</h1>
      <p class="lead">The yard you walk out to at the end of the day, and the one your friends talk about after they leave.</p>
      <p>Pools, outdoor kitchens, pergolas, and hardscape in Carlsbad, Encinitas, Del Mar, Rancho Santa Fe, and across San Diego County.</p>
      <p><a class="btn" href="/contact">Get in Touch</a></p>
    </div>
  </section>

  <main>
    <div class="wrap">
      <h2>Spend More Time Outside</h2>
      <p class="lead">
        San Diego gives you the weather to live outdoors most of the year. Most yards don't give you a reason to. We build the ones that do: the pool you slip into after work, the kitchen where dinner turns into the whole evening, the fire that keeps everyone out past dark.
      </p>
      <p class="lead">Before long, the yard is where your day ends.</p>

      <img class="photo" src="/images/stock/stock-pergola.jpg" alt="Wooden dining table and chairs under a pergola at night" />

      <ul class="grid">
        {services.slice(0, 8).map((s) => <li class="card">{s}</li>)}
      </ul>
      <p><a href="/services">See all services</a></p>

      <h2>The Details People Ask About</h2>
      <p class="lead">Some features take more work than most crews want to take on. We build them anyway, because they're the ones guests stop and admire: floating stairs, floating pool decks, and more.</p>

      <h2>Start With a Conversation</h2>
      <p class="lead">Tell us what you picture when you imagine your yard at its best. Call <a href={site.phoneHref}>{site.phone}</a> or send a message, and we'll take it from there.</p>
      <p><a class="btn" href="/contact">Get in Touch</a></p>
    </div>
  </main>
</Layout>
